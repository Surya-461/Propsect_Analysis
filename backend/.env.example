# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/prospect_db

# LLM Provider Configuration: 'ollama' or 'gemini'
LLM_PROVIDER=gemini
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Google Gemini API Key & Model
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-lite-latest
GEMINI_TIMEOUT=90

# JWT Authentication Secret Key & Algorithm
JWT_SECRET_KEY=your_secure_random_jwt_secret_key_here_min_32_characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Google OAuth 2.0 Client ID
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com

# External Search & Extraction Services
SERPER_API_KEY=your_serper_api_key_here
FIRECRAWL_API_KEY=your_firecrawl_api_key_here
TAVILY_API_KEY=your_tavily_api_key_here

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Admin Seeding (Set to 'true' only if initial admin creation on first run is desired)
SEED_DEFAULT_ADMIN=false